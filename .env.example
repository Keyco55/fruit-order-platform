# [선택] 기본 오픈카톡 테스트/공구방 링크 및 사이트 URL (OG 썸네일 절대경로용)
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=https://open.kakao.com/o/g7mQI5Wi
NEXT_PUBLIC_SITE_URL=

# [운영 필수] Supabase. production/preview에서 누락 시 접수를 거절합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [선택] 사장님 실시간 주문 알림용 텔레그램 봇 설정
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [관리자 필수] 독립적인 32바이트 이상의 암호학적 난수. 다른 secret을 재사용하지 마세요.
ADMIN_SESSION_SECRET=
# [신규 설치에만 필요] 최초 관리자 비밀번호. 기존 설치의 비밀번호는 성공한 로그인 시 hash로 전환됩니다.
ADMIN_INITIAL_PASSWORD=

# [로컬 테스트 전용] production build를 DB 없이 실행할 때만 명시적으로 true.
# Vercel production/preview는 이 옵션으로 DB 누락을 우회할 수 없습니다.
FRUIT_DEMO_MODE=false
# [선택] demo 파일 격리 경로. 테스트는 별도 임시 경로를 자동 사용합니다.
FRUIT_STORE_PATH=
# [비 Vercel 서버만] 신뢰할 수 있는 reverse proxy가 forwarded-for를 덮어쓰는 환경에서만 true.
TRUST_PROXY=false

# [선택] 카카오 bot 웹훅 전용 secret. 관리자 세션 키와 별개로 설정하세요.
KAKAO_WEBHOOK_SECRET=
